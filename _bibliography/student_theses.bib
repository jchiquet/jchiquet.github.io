@thesis{plassais2013,
  abbr = {PhD thesis},
  title={Développement méthodologique pour la méta-analyse appliquée à la
                  caractérisation de signatures chez les patients atteints
                  de maladie auto-immune},
  author={Plassais, Jonathan},
  year={2013},
  school={Université d'Évry-Val-d'Essonne},
  abstract = {This CIFRE thesis, carried out with the company TcLand Expression, develops statistical methodology for the meta-analysis of transcriptomic studies, with the aim of characterising molecular signatures in patients with autoimmune diseases. Combining studies conducted on different platforms, protocols and patient populations raises specific difficulties, from between-study heterogeneity to the multiplicity of tests, which the work addresses by adapting variable selection and aggregation procedures to this setting so that the signatures obtained are reproducible from one cohort to another rather than specific to a single study.},
  abstract_fr = {Cette thèse CIFRE, conduite avec la société TcLand Expression, développe une méthodologie statistique pour la méta-analyse d'études transcriptomiques, en vue de caractériser des signatures moléculaires chez des patients atteints de maladies auto-immunes. La combinaison d'études menées sur des plateformes, des protocoles et des populations de patients différents soulève des difficultés propres, de l'hétérogénéité entre études à la multiplicité des tests, que le travail traite en adaptant à ce cadre des procédures de sélection et d'agrégation de variables, afin que les signatures obtenues soient reproductibles d'une cohorte à l'autre plutôt que propres à une seule étude.}
}
